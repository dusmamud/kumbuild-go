PORT=8080
DATABASE_URL=postgres://kumbuild:kumbuild@localhost:5432/kumbuild_orders?sslmode=disable
BREVO_API_KEY=
MAIL_FROM=hello@kumbuild.com
OWNER_EMAIL=hello@kumbuild.com

# REQUIRED — Master automation token (long random string, never commit a real one)
ADMIN_TOKEN=

# REQUIRED — Owner login email for admin panel
ADMIN_EMAIL=

# REQUIRED — Bcrypt hash of owner password (generate using: go run ./cmd/hashpw)
ADMIN_PASSWORD_HASH=

# REQUIRED — Long random secret string used to sign session JWTs
JWT_SECRET=

TURNSTILE_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,https://kumbuild.com,https://www.kumbuild.com
